# init.sh generates a private .env. Keep passwords and the full connection string there.
COMPOSE_FILE=compose.yaml:compose.postgres.yaml
NODICARTA_CORE_IMAGE=ghcr.io/yafeiml/nodikarta-core:1.0.0
NODICARTA_BIND_ADDRESS=127.0.0.1
NODICARTA_PORT=8080
NODICARTA_LOCAL_HTTP=true
NODICARTA_PUBLIC_URL=
NODICARTA_TRUSTED_PROXY=

# Generated independently when using the bundled PostgreSQL.
NODICARTA_POSTGRES_PASSWORD=
NODICARTA_DB_PASSWORD=
NODICARTA_DATABASE=
