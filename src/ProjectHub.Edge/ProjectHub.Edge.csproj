<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Product>Nodicarta Edge</Product>
    <AssemblyTitle>Nodicarta Edge CLI</AssemblyTitle>
    <Version>1.1.1</Version>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) or ('$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT' and '$(EdgeLinux)' != 'true')">net10.0-windows</TargetFramework>
    <ApplicationIcon>../ProjectHub.Edge.Desktop/Assets/edge.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ProjectHub.Edge.Desktop" />
    <InternalsVisibleTo Include="ProjectHub.Edge.AccessChecks" />
    <InternalsVisibleTo Include="ProjectHub.Edge.AssetChecks" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.15" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>
</Project>
