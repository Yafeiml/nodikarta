@page "/account/password"
@model PasswordModel
@{
    ViewData["Title"] = T("修改密码","Change password");
}
<section class="auth-card" aria-labelledby="change-password-title">
    <h1 id="change-password-title">@ViewData["Title"]</h1>
    <p class="intro">@T("修改后，所有浏览器都需要使用新密码重新登录。","After changing your password, sign in again in every browser.")</p>
    @if (Model.Error is not null)
    {
        <p class="notice error" role="alert">@Model.Error</p>
    }
    <form method="post" class="stack">
        <input type="hidden" name="username" autocomplete="username" value="@User.Identity?.Name">
        <div class="field">
            <label for="current-password">@T("当前密码","Current password")</label>
            <input id="current-password" name="currentPassword" type="password" required maxlength="128" autocomplete="current-password">
        </div>
        <div class="field">
            <label for="new-password">@T("新密码","New password")</label>
            <input id="new-password" name="newPassword" type="password" required minlength="12" maxlength="128" autocomplete="new-password" aria-describedby="length-hint">
            <small id="length-hint">@T("使用 12 至 128 个字符。","Use 12 to 128 characters.")</small>
        </div>
        <div class="field">
            <label for="confirm-password">@T("确认新密码","Confirm new password")</label>
            <input id="confirm-password" name="confirmPassword" type="password" required minlength="12" maxlength="128" autocomplete="new-password">
        </div>
        <button type="submit" class="primary">@T("保存新密码","Save new password")</button>
    </form>
    <a class="button-link" asp-page="/Projects">@T("返回项目","Back to projects")</a>
</section>
