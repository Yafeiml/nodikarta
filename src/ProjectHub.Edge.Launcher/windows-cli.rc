#include <winver.h>

1 ICON "edge.ico"
// This fixed entry point has its own format version and can be shared by compatible releases.
1 VERSIONINFO
 FILEVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Nodicarta"
   VALUE "FileDescription", "Nodicarta Edge Launcher"
   VALUE "FileVersion", "1.0.0.0"
   VALUE "OriginalFilename", "ProjectHub.Edge.exe"
   VALUE "ProductName", "Nodicarta Edge"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
