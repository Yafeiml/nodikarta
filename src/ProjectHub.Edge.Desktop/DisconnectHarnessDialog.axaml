<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:ProjectHub.Edge.Desktop" x:Class="ProjectHub.Edge.Desktop.DisconnectHarnessDialog" x:ClassModifier="internal"
        Title="{ui:Tr '断开接入', English='Disconnect client'}" Width="392" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" SystemDecorations="BorderOnly" CanMinimize="False" CanMaximize="False" ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome" ExtendClientAreaTitleBarHeightHint="0"
        Background="White" Foreground="#172438" FontFamily="Microsoft YaHei UI, Segoe UI">
  <Grid RowDefinitions="Auto,Auto">
    <StackPanel Margin="20,16" Spacing="10">
      <TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" AutomationProperties.AutomationId="DisconnectHarnessHeading"/>
      <TextBlock x:Name="Note" Foreground="#52647A" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="1" Padding="20,12" Background="#F5F8FB" BorderBrush="#DCE4EF" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="CancelButton" MinWidth="88" Height="32" CornerRadius="6" HorizontalContentAlignment="Center" IsCancel="True"
                Content="{ui:Tr '取消', English='Cancel'}" Click="Cancel" AutomationProperties.AutomationId="CancelHarnessDisconnect"/>
        <Button MinWidth="88" Height="32" CornerRadius="6" HorizontalContentAlignment="Center" Background="#95403D" Foreground="White"
                Content="{ui:Tr '断开接入', English='Disconnect'}" Click="Confirm" AutomationProperties.AutomationId="ConfirmHarnessDisconnect"/>
      </StackPanel>
    </Border>
    <Border x:Name="Windows10Frame" Grid.RowSpan="2"/>
  </Grid>
</Window>
