<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button.titleClose">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.titleClose Path">
    <Setter Property="Data" Value="M2,2 L14,14 M14,2 L2,14"/>
    <Setter Property="Width" Value="13"/>
    <Setter Property="Height" Value="13"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Stroke" Value="#52647A"/>
    <Setter Property="StrokeThickness" Value="1.5"/>
  </Style>
  <Style Selector="Button.titleClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FFF0F0"/>
  </Style>
  <Style Selector="Button.titleClose:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F7DADA"/>
  </Style>
  <Style Selector="Button.pill">
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="MinHeight" Value="29"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="#2C4255"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.pill.action">
    <Setter Property="Background" Value="#F4F7FA"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.pill.current">
    <Setter Property="Background" Value="#DBE9F8"/>
    <Setter Property="Foreground" Value="#174D88"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.pill:not(.current):pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#EDF3F7"/>
    <Setter Property="Foreground" Value="#2C4255"/>
  </Style>
  <Style Selector="Button.pill:not(.current):pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#DFE9F2"/>
    <Setter Property="Foreground" Value="#2C4255"/>
  </Style>
  <Style Selector="WrapPanel.pillGroup">
    <Setter Property="ItemSpacing" Value="2"/>
    <Setter Property="LineSpacing" Value="2"/>
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Foreground" Value="#285B90"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.link Path">
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
  </Style>
  <Style Selector="Button.link:pointerover, Button.link:pressed">
    <Setter Property="Foreground" Value="#15497F"/>
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#15497F"/>
  </Style>
  <Style Selector="Button.link:pointerover TextBlock.linkLabel, Button.link:focus-visible TextBlock.linkLabel">
    <Setter Property="TextDecorations" Value="Underline"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Foreground" Value="#657586"/>
    <Setter Property="Cursor" Value="Arrow"/>
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="#657586"/>
    <Setter Property="Background" Value="#EDF1F5"/>
    <Setter Property="BorderBrush" Value="#D7DFE7"/>
  </Style>
  <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.link:disabled TextBlock.linkLabel">
    <Setter Property="TextDecorations" Value="{x:Null}"/>
  </Style>
</Styles>
